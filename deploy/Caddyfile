# Public entry point. The app itself only listens on 127.0.0.1.
ezdsviewer.com {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	reverse_proxy 127.0.0.1:8000
}

www.ezdsviewer.com {
	redir https://ezdsviewer.com{uri} permanent
}
